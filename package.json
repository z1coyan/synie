{
  "name": "synie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:apps": "turbo run dev --filter=@synie/server --filter=synie-web",
    "dev:server": "bun run --filter @synie/server dev",
    "dev:web": "bun run --filter synie-web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bun run --filter @synie/server db:migrate",
    "db:seed": "bun run --filter @synie/server db:seed",
    "db:reset": "bun run --filter @synie/server db:reset",
    "test": "turbo run test --filter=@synie/shared --filter=@synie/server",
    "typecheck": "turbo run typecheck --filter=@synie/shared --filter=@synie/server --filter=synie-web",
    "build": "turbo run build --filter=synie-web"
  },
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-pro",
    "heroui-native-pro"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "turbo": "^2.5.4",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
