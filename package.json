{
  "name": "synie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:infra": "bun infra/convex/dev-infra.ts",
    "dev:convex": "bunx convex dev",
    "dev:web": "bun run --filter synie-web dev",
    "infra:up": "bun infra/convex/dev-infra.ts",
    "infra:health": "bun infra/convex/health.ts",
    "infra:down": "bun infra/convex/compose.ts down --remove-orphans",
    "infra:logs": "bun infra/convex/compose.ts logs --no-color convex-postgres minio minio-public minio-init convex-backend convex-dashboard",
    "reset": "bun infra/convex/reset.ts",
    "db:reset": "bun infra/convex/reset.ts",
    "convex:bootstrap": "bun infra/convex/bootstrap.ts",
    "convex:backup": "bun infra/convex/backup.ts",
    "convex:restore": "bun infra/convex/restore.ts",
    "convex:repair-candidates": "bun infra/convex/candidate-repair.ts",
    "test:self-hosted-restore": "bun infra/convex/restore-smoke-runner.ts",
    "test:self-hosted-auth": "bun infra/convex/auth-smoke.ts",
    "test:self-hosted-resources": "bun infra/convex/resource-smoke.ts",
    "test:self-hosted-engines": "bun infra/convex/engine-smoke.ts",
    "test:printing-self-hosted": "bun infra/convex/printing-smoke.ts",
    "test:s3-compat": "bun infra/convex/s3-compat-smoke.ts",
    "check:convex-manifest": "bun scripts/check-convex-manifest.ts",
    "check:convex-engine-matrix": "bun scripts/check-convex-engine-matrix.ts",
    "check:convex-closures": "bun scripts/check-convex-closures.ts",
    "check:convex-cutover-readiness": "bun scripts/check-convex-cutover-readiness.ts",
    "check:no-legacy-server": "bun scripts/check-no-legacy-server.ts",
    "generate:convex-web-manifest": "bun scripts/generate-convex-web-manifest.ts",
    "check:generated": "bun run generate:convex-web-manifest && git diff --exit-code -- web/app/lib/resources/convex-domain-manifest.ts",
    "check": "bun run check:convex-manifest && bun run check:convex-engine-matrix && bun run check:convex-closures && bun run check:convex-cutover-readiness && bun run check:no-legacy-server && bun run check:generated && bun run --filter synie-web check",
    "typecheck:infra": "tsc -p infra/convex/tsconfig.json",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test": "bun test convex && turbo run test --filter=@synie/shared --filter=synie-web",
    "typecheck": "bun run typecheck:infra && bun run typecheck:convex && turbo run typecheck --filter=@synie/shared --filter=synie-web",
    "e2e:self-hosted": "bun run test:self-hosted-auth && bun run test:self-hosted-resources && bun run test:self-hosted-engines && bun run test:s3-compat && bun run test:printing-self-hosted",
    "build": "turbo run build --filter=synie-web"
  },
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-pro",
    "heroui-native-pro"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "22.15.3",
    "convex": "1.42.3",
    "turbo": "^2.5.4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@aws-sdk/client-s3": "3.864.0",
    "@aws-sdk/s3-request-presigner": "3.864.0",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/react-query": "0.1.0",
    "@synie/shared": "workspace:*",
    "better-auth": "1.6.25",
    "convex-helpers": "0.1.120"
  }
}
