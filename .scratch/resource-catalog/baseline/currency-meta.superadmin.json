{
  "schemaVersion": 2,
  "name": "basCurrencies",
  "label": "货币",
  "permissionPrefix": "base.currency",
  "capabilities": [
    "create",
    "update",
    "delete"
  ],
  "fields": [
    {
      "name": "id",
      "label": "id",
      "visibility": "readable",
      "input": {
        "create": "forbidden",
        "update": "forbidden"
      },
      "filterable": false,
      "sortable": true,
      "kind": "uuid"
    },
    {
      "name": "name",
      "label": "货币名称",
      "visibility": "readable",
      "input": {
        "create": "required",
        "update": "allowed",
        "clearable": false
      },
      "filterable": true,
      "sortable": true,
      "searchable": true,
      "kind": "scalar",
      "scalarType": "string"
    },
    {
      "name": "isoCode",
      "label": "ISO 编码",
      "visibility": "readable",
      "input": {
        "create": "required",
        "update": "forbidden"
      },
      "filterable": true,
      "sortable": true,
      "searchable": true,
      "kind": "scalar",
      "scalarType": "string"
    },
    {
      "name": "symbol",
      "label": "符号",
      "visibility": "readable",
      "input": {
        "create": "optional",
        "update": "allowed",
        "clearable": true
      },
      "filterable": true,
      "sortable": true,
      "searchable": true,
      "kind": "scalar",
      "scalarType": "string"
    },
    {
      "name": "active",
      "label": "启用",
      "visibility": "readable",
      "input": {
        "create": "optional",
        "update": "allowed",
        "clearable": true
      },
      "filterable": true,
      "sortable": true,
      "kind": "scalar",
      "scalarType": "boolean"
    },
    {
      "name": "insertedAt",
      "label": "创建时间",
      "visibility": "readable",
      "input": {
        "create": "forbidden",
        "update": "forbidden"
      },
      "filterable": true,
      "sortable": true,
      "kind": "scalar",
      "scalarType": "datetime"
    },
    {
      "name": "updatedAt",
      "label": "更新时间",
      "visibility": "readable",
      "input": {
        "create": "forbidden",
        "update": "forbidden"
      },
      "filterable": true,
      "sortable": true,
      "kind": "scalar",
      "scalarType": "datetime"
    }
  ],
  "lookup": {
    "labelField": "name",
    "searchFields": [
      "name",
      "isoCode"
    ],
    "subtitleFields": [
      "isoCode"
    ]
  },
  "list": {
    "columns": [
      "id",
      "name",
      "isoCode",
      "symbol",
      "active",
      "insertedAt",
      "updatedAt"
    ]
  },
  "form": {
    "kind": "basic",
    "layout": {
      "fields": [
        {
          "field": "name",
          "placeholder": "如 人民币"
        },
        {
          "field": "isoCode",
          "placeholder": "三位大写字母,如 CNY"
        },
        {
          "field": "symbol",
          "placeholder": "如 ¥"
        }
      ]
    }
  },
  "commands": []
}
