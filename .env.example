# HeroUI Pro token，从 https://heroui.pro/dashboard 获取
HEROUI_PERSONAL_TOKEN=
HEROUI_AUTH_TOKEN=

# 自托管 Convex：backend 与 dashboard 必须使用同一个完整、不可变 tag。
CONVEX_VERSION=19431ea0dd90bc55ae58dbbd06d9aa045f97336f
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
# Convex Node action 回调地址；Compose 内保持服务名，不要填写宿主机映射端口。
CONVEX_INTERNAL_ORIGIN=http://convex-backend:3210
# 容器内 issuer/JWKS 地址；浏览器与 TanStack proxy 使用下一行的 public URL。
CONVEX_SITE_ORIGIN=http://convex-backend:3211
SYNIE_CONVEX_PUBLIC_SITE_URL=http://127.0.0.1:3211
# TanStack SSR/server functions use Compose private DNS; browser URLs remain
# VITE_CONVEX_URL/VITE_CONVEX_SITE_URL.
SYNIE_CONVEX_INTERNAL_URL=http://convex-backend:3210
SYNIE_CONVEX_INTERNAL_SITE_URL=http://convex-backend:3211

# 仅本地开发的 PostgreSQL/MinIO 凭据；生产值由 secret manager 注入。
CONVEX_POSTGRES_USER=convex
CONVEX_POSTGRES_PASSWORD=convex-local-development-only
AWS_ACCESS_KEY_ID=synie-local
AWS_SECRET_ACCESS_KEY=synie-local-development-only
SYNIE_S3_REGION=us-east-1
SYNIE_S3_INTERNAL_ENDPOINT=http://minio:9000
SYNIE_S3_PUBLIC_ENDPOINT=http://localhost:9000
SYNIE_PRODUCT_FILES_CORS_ORIGIN=http://localhost:3000
# 以下产品存储值需通过 `convex env set --from-file` 注入本地 deployment。
SYNIE_S3_ACCESS_KEY_ID=synie-local
SYNIE_S3_SECRET_ACCESS_KEY=synie-local-development-only
SYNIE_PRODUCT_FILES_BUCKET=synie-product-files
# PDF Worker 的内部 v1 contract。HMAC 值须为至少 32 bytes 随机 secret，并同时通过
# `convex env set` 注入 deployment；此文件不提供可复用 secret。
PRINT_WORKER_URL=http://web:3000
PRINT_WORKER_HMAC_SECRET=
PRINT_WORKER_HMAC_PREVIOUS_SECRET=
PRINT_WORKER_ALLOWED_HOSTS=minio
PRINT_WORKER_TIMEOUT_MS=120000
PRINT_WORKER_CONCURRENCY=2
# 通过 `convex env set` 写入 deployment secret；留空时 UI 显示“请联系管理员”。
SYNIE_OCR_ACCESS_KEY_ID=
SYNIE_OCR_ACCESS_KEY_SECRET=

# 可按需覆盖本地映射端口。
CONVEX_POSTGRES_PORT=5442
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791
WEB_PORT=3000
