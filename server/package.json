{
  "name": "@synie/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./client": "./src/client.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun db/migrate.ts",
    "db:seed": "bun db/seed.ts",
    "db:reset": "bun db/reset.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/db/types.d.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.4",
    "@synie/shared": "workspace:*",
    "fflate": "^0.8.3",
    "hono": "^4.10.7",
    "kysely": "^0.28.8",
    "kysely-postgres-js": "^3.0.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "kysely-codegen": "^0.19.0",
    "pg": "^8.16.3",
    "typescript": "^5.5.0"
  }
}
