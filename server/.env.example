# 服务监听
PORT=8080
HOST=0.0.0.0

# PostgreSQL（二选一：完整 DSN，或 PG* 分件）
DATABASE_URL=postgres://synie:synie@localhost:5441/synie?sslmode=disable
# PGHOST=localhost
# PGPORT=5441
# PGUSER=synie
# PGPASSWORD=synie
# PGDATABASE=synie

# 认证（至少 32 字节）
AUTH_SECRET=local-development-secret-change-me-32-bytes
# 登录令牌有效期：数字+单位（s/m/h/d）
AUTH_TOKEN_TTL=168h

# 浏览器可达的应用 origin（非 API 直连端口）。本地 dev 用前端端口。
# 启用 Logto 时必填；单入口时 OAuth redirect_uri = {BETTER_AUTH_URL}/api/v1/auth/oauth2/callback/logto
# 须将该完整 URL 登记到 Logto 应用的 Redirect URIs。
BETTER_AUTH_URL=http://localhost:3000
# 多入口（局域网 IP / Tailscale 主机名）时逗号分隔 host:port；支持 *.ts.net 通配。
# 每个入口的 {origin}/api/v1/auth/oauth2/callback/logto 都要在 Logto Redirect URIs 登记。
# BETTER_AUTH_ALLOWED_HOSTS=100.93.251.66:3000,home-n5pro:3000,*.ts.net

# Logto OIDC（可选；三项要么全有要么全无，齐备才启用 Logto 登录）
# LOGTO_ISSUER=https://your-tenant.logto.app/oidc
# LOGTO_CLIENT_ID=
# LOGTO_CLIENT_SECRET=

# 日志：debug/info/warn/error
LOG_LEVEL=info

# 打印 PDF（LibreOffice soffice；可选，缺省走 PATH 中的 soffice）
# SOFFICE_PATH=/usr/bin/soffice
# SOFFICE_TIMEOUT_MS=120000
# SOFFICE_MAX_CONCURRENCY=2

# 首次种子管理员（bun run db:seed）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=系统管理员

# PG 集成测试门控（指向已迁移的测试库；不设则集成测试 Skip）
# SYNIE_TEST_DATABASE_URL=postgres://synie:synie@localhost:5441/synie_test?sslmode=disable
