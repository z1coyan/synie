{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "rootDir": "..",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "bun",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "~/*": [
        "./app/*"
      ],
      "@synie/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@synie/shared/*": [
        "../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "app",
    "vite.config.ts"
  ]
}
