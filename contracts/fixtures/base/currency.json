{
  "resource": "basCurrencies",
  "permissionPrefix": "base.currency",
  "cases": [
    {
      "name": "创建默认启用且符号可空",
      "input": {"name": "美元", "isoCode": "USD"},
      "expected": {"active": true, "symbol": null}
    },
    {
      "name": "可显式创建停用",
      "input": {"name": "欧元", "isoCode": "EUR", "active": false},
      "expected": {"active": false}
    },
    {
      "name": "ISO 必须三位大写字母",
      "invalidIsoCodes": ["cny", "CN", "CNYY", "C1Y"]
    },
    {
      "name": "ISO 唯一且创建后不可改",
      "isoCode": "JPY"
    },
    {
      "name": "公司本币不可停用",
      "error": "已被公司引用为本币,不可停用"
    }
  ]
}
