# 自托管 Convex backend/dashboard 必须使用同一不可变 image tag 或 digest。
CONVEX_VERSION=19431ea0dd90bc55ae58dbbd06d9aa045f97336f
CONVEX_CLOUD_ORIGIN=https://convex.example.com
# backend/Node action 可达的内部回调地址；不得填写浏览器侧 loopback/端口映射。
CONVEX_INTERNAL_ORIGIN=http://convex-backend:3210
CONVEX_SITE_ORIGIN=https://convex-site.example.com
SYNIE_CONVEX_PUBLIC_SITE_URL=https://convex-site.example.com
# TanStack Start SSR/server functions must reach Convex on the private network.
SYNIE_CONVEX_INTERNAL_URL=http://convex-backend:3210
SYNIE_CONVEX_INTERNAL_SITE_URL=http://convex-backend:3211
# 64 位随机 hex；由 secret manager 注入。若不用 env，则必须持久化 /convex/data/credentials。
CONVEX_INSTANCE_SECRET=

# PostgreSQL 17 与 Convex backend 应同 region。密码必须由 secret manager 注入。
CONVEX_POSTGRES_USER=convex
CONVEX_POSTGRES_PASSWORD=
# 生产优先由 secret manager 注入完整、已 URL-encode 的 TLS DSN；不要依赖 Compose 字符串拼接。
CONVEX_POSTGRES_URL=
CONVEX_POSTGRES_DO_NOT_REQUIRE_SSL=0

# 第三方 S3-compatible provider；内部 endpoint 用于服务访问，public endpoint 用于浏览器签名 URL。
SYNIE_S3_REGION=
SYNIE_S3_INTERNAL_ENDPOINT=
SYNIE_S3_PUBLIC_ENDPOINT=
SYNIE_PRODUCT_FILES_CORS_ORIGIN=https://erp.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_DISABLE_SSE=false

# 下列值通过 `convex env set --from-file` 注入 deployment；不进入 image 或业务表。
SYNIE_S3_ACCESS_KEY_ID=
SYNIE_S3_SECRET_ACCESS_KEY=
SYNIE_PRODUCT_FILES_BUCKET=synie-product-files

# TanStack Start serverful PDF converter。URL 只在容器私网解析；两个 deployment
# 同时配置同一随机 HMAC secret，轮换窗口可暂时保留 previous secret。
PRINT_WORKER_URL=http://web:3000
PRINT_WORKER_HMAC_SECRET=
PRINT_WORKER_HMAC_PREVIOUS_SECRET=
PRINT_WORKER_ALLOWED_HOSTS=
PRINT_WORKER_TIMEOUT_MS=120000
PRINT_WORKER_CONCURRENCY=2

# OCR 凭证只进入 Convex deployment secret，不存业务表、浏览器或 Compose image。
SYNIE_OCR_ACCESS_KEY_ID=
SYNIE_OCR_ACCESS_KEY_SECRET=

# Provider 上线前必须通过 infra/convex S3 compatibility suite：
# - S3 SigV4 与 path-style endpoint
# - private bucket，拒绝 anonymous read/write
# - presigned PUT/GET/HEAD 及 synie-product-files 的 bucket-level 浏览器 CORS
# - PUT checksum 校验、HEAD checksum/metadata
# - server-side CopyObject 后 checksum 不变
# - 六个 bucket 的独立 lifecycle/backup policy；只允许 uploads/、print-tmp/ 自动过期，files/ 禁止过期
