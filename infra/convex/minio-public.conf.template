server {
  listen 9000;
  server_name _;

  client_max_body_size 0;
  proxy_request_buffering off;
  proxy_buffering off;

  # Health remains available to local tooling without adding browser CORS.
  location = /minio/health/live {
    proxy_pass http://minio:9000;
    proxy_set_header Host $http_host;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Expose-Headers;
  }

  # Only product bytes are browser-facing. OPTIONS is answered here because
  # MinIO Community no longer supports bucket-scoped CORS configuration.
  location ~ ^/synie-product-files(?:/|$) {
    if ($request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "${SYNIE_PRODUCT_FILES_CORS_ORIGIN}" always;
      add_header Access-Control-Allow-Methods "GET, HEAD, PUT, OPTIONS" always;
      add_header Access-Control-Allow-Headers "content-type, x-amz-content-sha256, x-amz-checksum-sha256, x-amz-meta-sha256, x-amz-date, authorization" always;
      add_header Access-Control-Max-Age "3600" always;
      add_header Vary "Origin" always;
      return 204;
    }

    proxy_pass http://minio:9000;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Expose-Headers;
    add_header Access-Control-Allow-Origin "${SYNIE_PRODUCT_FILES_CORS_ORIGIN}" always;
    add_header Access-Control-Expose-Headers "etag, x-amz-checksum-sha256, x-amz-version-id" always;
    add_header Vary "Origin" always;
  }

  # Non-browser local diagnostics may still reach internal private buckets,
  # but no CORS capability is emitted for them.
  location / {
    proxy_pass http://minio:9000;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Expose-Headers;
  }
}
